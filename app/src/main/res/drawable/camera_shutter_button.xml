<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Внешний круг -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#EEEEEE" />
        </shape>
    </item>

    <!-- Внутренний круг -->
    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>

</layer-list>
